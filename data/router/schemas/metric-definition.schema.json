{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "aliases", "group", "direction", "auxiliary", "description"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "group": { "enum": ["latent_geometry", "continuity", "trajectory", "stability", "biology", "resources"] },
    "direction": { "enum": ["higher_is_better", "lower_is_better"] },
    "auxiliary": { "type": "boolean" },
    "description": { "type": "string", "minLength": 1 }
  }
}
