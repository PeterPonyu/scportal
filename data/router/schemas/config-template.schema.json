{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-template.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["methodId", "version", "synthetic", "template"],
  "properties": {
    "methodId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "synthetic": { "type": "boolean" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs", "packageName", "importName", "constructor", "defaultParameters", "allowedParameters", "outputKeys"],
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["latent", "graph", "pseudotime", "branch", "metadata"] }
        },
        "packageName": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "importName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "constructor": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "defaultParameters": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
        "allowedParameters": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["type"],
            "properties": {
              "type": { "enum": ["string", "number", "boolean"] },
              "minimum": { "type": "number" }, "maximum": { "type": "number" }, "integer": { "type": "boolean" },
              "enum": { "type": "array", "items": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } }
            }
          }
        },
        "outputKeys": {
          "type": "object", "additionalProperties": false, "required": ["latent", "metadata"],
          "properties": { "latent": { "type": "string", "minLength": 1 }, "graph": { "type": "string", "minLength": 1 }, "pseudotime": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 }, "metadata": { "type": "string", "minLength": 1 } }
        },
        "downstream": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "scFocus": { "type": "object", "additionalProperties": false, "required": ["contributionOutput"], "properties": { "contributionOutput": { "type": "string", "minLength": 1 }, "branchKey": { "type": "string", "minLength": 1 } } },
            "scRL": { "type": "object", "additionalProperties": false, "required": ["decisionOutput"], "properties": { "decisionOutput": { "type": "string", "minLength": 1 }, "pseudotimeKey": { "type": "string", "minLength": 1 } } }
          }
        }
      }
    }
  }
}
