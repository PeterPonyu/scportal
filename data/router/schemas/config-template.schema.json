{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-template.schema.json",
  "$defs": {
    "outputCallables": { "type": "object", "additionalProperties": false, "properties": { "latent": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "graph": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "pseudotime": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "branch": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "metadata": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["methodId", "version", "synthetic", "template"],
  "properties": {
    "methodId": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "version": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "synthetic": { "type": "boolean" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs", "packageName", "packageVersion", "importName", "constructor", "wrapper", "defaultParameters", "allowedParameters", "outputKeys"],
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["latent", "graph", "pseudotime", "branch", "metadata"] }
        },
        "packageName": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "packageVersion": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]*$" },
        "importName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "constructor": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "wrapper": {
          "type": "object", "additionalProperties": false, "required": ["fitMethod", "input"],
          "properties": {
            "style": { "enum": ["fit_transform", "constructor_fit_getter"] },
            "metadataSource": { "enum": ["method", "router"] },
            "fitMethod": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "input": { "const": "adata" },
            "fitParameters": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
            "resultAttributes": { "$ref": "#/$defs/outputCallables" },
            "resultGetters": { "$ref": "#/$defs/outputCallables" }
          },
          "allOf": [
            { "if": { "properties": { "style": { "const": "constructor_fit_getter" } }, "required": ["style"] }, "then": { "required": ["resultGetters"], "properties": { "resultGetters": { "$ref": "#/$defs/outputCallables" }, "resultAttributes": false } }, "else": { "required": ["resultAttributes"], "properties": { "resultAttributes": { "$ref": "#/$defs/outputCallables" }, "resultGetters": false } } }
          ]
        },
        "defaultParameters": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
        "allowedParameters": {
          "type": "object", "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["type"],
            "properties": {
              "type": { "enum": ["string", "number", "boolean"] },
              "minimum": { "type": "number" }, "maximum": { "type": "number" }, "integer": { "type": "boolean" },
              "enum": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } }
            },
            "allOf": [
              { "if": { "properties": { "type": { "const": "number" } } }, "then": {}, "else": { "properties": { "minimum": false, "maximum": false, "integer": false } } },
              { "if": { "properties": { "type": { "const": "string" } } }, "then": { "properties": { "enum": { "type": "array", "items": { "type": "string" } } } } },
              { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "enum": { "type": "array", "items": { "type": "number" } } } } },
              { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "enum": { "type": "array", "items": { "type": "boolean" } } } } }
            ]
          }
        },
        "outputKeys": {
          "type": "object", "additionalProperties": false, "required": ["latent", "metadata"],
          "properties": { "latent": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "graph": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "pseudotime": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "branch": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "metadata": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" } }
        },
        "downstream": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "scFocus": { "type": "object", "additionalProperties": false, "required": ["packageName", "packageVersion", "installCommand", "sourceUrl", "importName", "functionName", "contributionOutput"], "properties": { "packageName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "packageVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]*$" }, "installCommand": { "type": "string", "pattern": "^(?:python(?:3)? -m pip|pip(?:3)?) install [A-Za-z0-9][A-Za-z0-9._-]*==[A-Za-z0-9][A-Za-z0-9._+!-]*$" }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "importName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "functionName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "contributionOutput": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "branchKey": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" } } },
            "scRL": { "type": "object", "additionalProperties": false, "required": ["packageName", "packageVersion", "installCommand", "sourceUrl", "importName", "functionName", "decisionOutput"], "properties": { "packageName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "packageVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]*$" }, "installCommand": { "type": "string", "pattern": "^(?:python(?:3)? -m pip|pip(?:3)?) install [A-Za-z0-9][A-Za-z0-9._-]*==[A-Za-z0-9][A-Za-z0-9._+!-]*$" }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "importName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "functionName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "decisionOutput": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "pseudotimeKey": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" } } }
          }
        }
      }
    }
  }
}
