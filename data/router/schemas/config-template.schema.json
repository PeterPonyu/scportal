{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-template.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["methodId", "version", "synthetic", "template"],
  "properties": {
    "methodId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "synthetic": { "type": "boolean" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs"],
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["latent", "graph", "pseudotime", "branch", "metadata"] }
        }
      }
    }
  }
}
