{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "method-capability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "aliases", "version", "modalities", "maxScale", "outputs", "requiredPriors", "supportedGoals", "resourceTier", "installCommand", "license", "sourceUrl", "docsUrl", "paperUrl", "executable"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" } },
    "version": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "modalities": { "type": "array", "minItems": 1, "items": { "enum": ["scrna", "scatac", "multiome"] } },
    "maxScale": { "enum": ["lt_10k", "10k_50k", "50k_200k", "gt_200k"] },
    "outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["latent", "graph", "pseudotime", "branch", "metadata"] } },
    "requiredPriors": { "type": "array", "items": { "enum": ["time", "root_state", "terminal_states", "labels", "perturbation"] } },
    "supportedGoals": { "type": "array", "minItems": 1, "items": { "enum": ["latent_representation", "trajectory_reconstruction", "fate_decision", "lineage_contribution"] } },
    "resourceTier": { "enum": [1, 2, 3] },
    "installCommand": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "license": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://[^\\u0000-\\u001F\\u007F]+$" },
    "docsUrl": { "type": "string", "format": "uri", "pattern": "^https?://[^\\u0000-\\u001F\\u007F]+$" },
    "paperUrl": { "type": "string", "format": "uri", "pattern": "^https?://[^\\u0000-\\u001F\\u007F]+$" },
    "executable": { "type": "boolean" }
  }
}
