{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executable-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routerVersion", "evidenceVersion", "method", "preprocessing", "parameters", "outputs", "downstream", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "routerVersion": { "type": "string", "minLength": 1 },
    "evidenceVersion": { "type": "string", "minLength": 1 },
    "method": { "type": "object", "additionalProperties": false, "required": ["id", "version", "install"], "properties": { "id": { "type": "string", "minLength": 1, "pattern": "\\S" }, "version": { "type": "string", "minLength": 1 }, "install": { "type": "string", "minLength": 1 } } },
    "preprocessing": { "type": "object", "additionalProperties": false, "required": ["modality", "normalization", "featureSelection"], "properties": { "modality": { "enum": ["scrna", "scatac", "multiome"] }, "normalization": { "type": "string", "minLength": 1 }, "featureSelection": { "type": "string", "minLength": 1 } } },
    "parameters": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
    "outputs": { "type": "object", "additionalProperties": false, "required": ["latent", "metadata"], "properties": { "latent": { "type": "string", "minLength": 1 }, "graph": { "type": "string", "minLength": 1 }, "pseudotime": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 }, "metadata": { "type": "string", "minLength": 1 } } },
    "downstream": { "type": "object", "additionalProperties": false, "properties": { "scFocus": { "type": "object", "additionalProperties": false, "required": ["latentKey", "contributionOutput"], "properties": { "latentKey": { "type": "string", "minLength": 1 }, "branchKey": { "type": "string", "minLength": 1 }, "contributionOutput": { "type": "string", "minLength": 1 } } }, "scRL": { "type": "object", "additionalProperties": false, "required": ["latentKey", "decisionOutput"], "properties": { "latentKey": { "type": "string", "minLength": 1 }, "pseudotimeKey": { "type": "string", "minLength": 1 }, "decisionOutput": { "type": "string", "minLength": 1 } } } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["recommendationSeed", "methodSource", "generatedAt"], "properties": { "recommendationSeed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "methodSource": { "type": "string", "minLength": 1 }, "generatedAt": { "type": "string", "minLength": 1 } } }
  }
}
