{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executable-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routerVersion", "evidenceVersion", "method", "preprocessing", "parameters", "outputs", "downstream", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "routerVersion": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "evidenceVersion": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "method": { "type": "object", "additionalProperties": false, "required": ["id", "version", "packageName", "packageVersion", "install"], "properties": { "id": { "type": "string", "minLength": 1, "pattern": "\\S" }, "version": { "type": "string", "minLength": 1 }, "packageName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "packageVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]*$" }, "install": { "type": "string", "pattern": "^(?:python(?:3)? -m pip|pip(?:3)?) install [A-Za-z0-9][A-Za-z0-9._-]*==[A-Za-z0-9][A-Za-z0-9._+!-]*$" } } },
    "preprocessing": { "type": "object", "additionalProperties": false, "required": ["modality", "normalization", "featureSelection"], "properties": { "modality": { "enum": ["scrna", "scatac", "multiome"] }, "normalization": { "type": "string", "minLength": 1 }, "featureSelection": { "type": "string", "minLength": 1 } } },
    "parameters": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
    "outputs": { "type": "object", "additionalProperties": false, "required": ["latent", "metadata"], "properties": { "latent": { "type": "string", "minLength": 1 }, "graph": { "type": "string", "minLength": 1 }, "pseudotime": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 }, "metadata": { "type": "string", "minLength": 1 } } },
    "downstream": { "type": "object", "additionalProperties": false, "properties": { "scFocus": { "type": "object", "additionalProperties": false, "required": ["packageName", "packageVersion", "installCommand", "sourceUrl", "importName", "functionName", "latentKey", "contributionOutput"], "properties": { "packageName": { "type": "string" }, "packageVersion": { "type": "string" }, "installCommand": { "type": "string" }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "importName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "functionName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "latentKey": { "type": "string", "minLength": 1 }, "branchKey": { "type": "string", "minLength": 1 }, "contributionOutput": { "type": "string", "minLength": 1 } } }, "scRL": { "type": "object", "additionalProperties": false, "required": ["packageName", "packageVersion", "installCommand", "sourceUrl", "importName", "functionName", "latentKey", "pseudotimeKey", "decisionOutput"], "properties": { "packageName": { "type": "string" }, "packageVersion": { "type": "string" }, "installCommand": { "type": "string" }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "importName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "functionName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "latentKey": { "type": "string", "minLength": 1 }, "pseudotimeKey": { "type": "string", "minLength": 1 }, "decisionOutput": { "type": "string", "minLength": 1 } } } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["recommendationSeed", "methodSource", "generatedAt", "profileFingerprint", "release", "outcome"], "properties": { "recommendationSeed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "methodSource": { "type": "string", "format": "uri", "pattern": "^https?://[^\\u0000-\\u001F\\u007F]+$" }, "generatedAt": { "type": "string", "format": "date-time", "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }, "profileFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "release": { "type": "object", "additionalProperties": false, "required": ["id", "synthetic", "configDigest", "evidenceDigest"], "properties": { "id": { "type": "string", "minLength": 1 }, "synthetic": { "type": "boolean" }, "configDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }, "outcome": { "type": "object", "additionalProperties": false, "required": ["status", "methodId"], "properties": { "status": { "const": "OK" }, "methodId": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" } } } } }
  }
}
