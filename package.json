{
  "name": "scportal-hub",
  "version": "1.0.0",
  "description": "Single-Cell Portal Hub - Unified platform combining iAODE Dataset Browser and LAIOR Benchmarking Dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "node --experimental-strip-types --test",
    "typecheck:router": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext app/core/router/types.ts app/core/router/ids.ts app/core/router/normalize.ts app/core/router/gower.ts app/core/router/shrinkage.ts",
    "validate:router-data": "node scripts/validate_router_data.mjs",
    "validate:public-graph": "node scripts/validate_public_graph.mjs",
    "check:rendered-public-graph": "node scripts/check_rendered_public_graph.mjs",
    "check": "npm run lint && npm run validate:public-graph && npm run generate && npm run check:rendered-public-graph"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "nuxt": "^3.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^1.7.0",
    "@nuxt/eslint": "^0.7.4",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@vueuse/nuxt": "^12.4.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterPonyu/scportal.git"
  },
  "keywords": [
    "single-cell",
    "bioinformatics",
    "scATAC-seq",
    "scRNA-seq",
    "benchmarking",
    "nuxt",
    "vue"
  ],
  "author": "Zeyu Fu",
  "license": "MIT"
}
